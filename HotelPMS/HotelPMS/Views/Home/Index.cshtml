                                <th>Mã Booking</th>
                                <th>Phòng</th>
                                <th>Khách Hàng</th>
                                <th>Ngày Nhận</th>
                                <th>Ngày Trả</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác Lễ Tân</th>
                            </tr>
                        </thead>
                        <tbody id="bookingTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. Quản Lý Phòng -->
        <div class="tab-pane fade" id="content-rooms">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-house-gear text-danger me-2"></i> [Admin] Danh Mục Quản Lý Phòng Khách Sạn</h5>
                    <button class="btn btn-danger fw-bold admin-only" onclick="openAddRoomModal()">
                        <i class="bi bi-plus-circle me-1"></i> + Thêm Phòng Mới (Admin)
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Phòng</th>
                                <th>Số Phòng</th>
                                <th>Mã Loại Phòng</th>
                                <th>Trạng Thái Hiện Tại</th>
                            </tr>
                        </thead>
                        <tbody id="roomAdminTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. Quản Lý Khách Hàng -->
        <div class="tab-pane fade" id="content-customer">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> Hồ Sơ Quản Lý Khách Hàng</h5>
                    <button class="btn btn-success fw-bold" onclick="openAddCustomerModal()">
                        <i class="bi bi-person-plus me-1"></i> + Thêm Khách Hàng Mới
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã KH</th>
                                <th>Họ Và Tên</th>
                                <th>Số CCCD</th>
                                <th>Số Điện Thoại</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody id="customerTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 5. Quản Lý Dịch Vụ -->
        <div class="tab-pane fade" id="content-services">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
