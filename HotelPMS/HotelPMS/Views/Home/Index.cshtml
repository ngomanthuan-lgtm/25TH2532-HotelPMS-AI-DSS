    <!-- Nội Dung Các Tab -->
    <div class="tab-content" id="pmsTabContent">
        <!-- TAB MỨC 2 -->
        <div class="tab-pane fade" id="content-ai-dss">
            <div class="card border-0 shadow-sm p-4 mb-4 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold text-danger mb-1">
                            <i class="bi bi-cpu me-2"></i> PHÂN HỆ MỨC 2: AI DỰ BÁO HỦY PHÒNG (XGBOOST) & HỆ HỖ TRỢ QUYẾT ĐỊNH (SHAP DSS)
                        </h4>
                        <p class="text-muted small mb-0">Tích hợp mô hình Học máy XGBoost Classifier (ROC-AUC = 0.938), giải thích SHAP và luật Hotel Operations Ontology.</p>
                    </div>
                    <span class="badge bg-dark fs-6">Sinh viên: Ngô Mẫn Thuận - 25TH2532</span>
                </div>

                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm p-3 bg-white">
                            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-sliders me-2"></i> Thông Số Đơn Đặt Phòng (Input)</h5>

                            <div class="mb-3 p-2 bg-light rounded">
                                <span class="small fw-bold text-muted d-block mb-1">Bước 1: Chọn mẫu thử điền thông số:</span>
                                <button type="button" class="btn btn-sm btn-outline-danger me-1 fw-bold" onclick="setPreset(1)">Kịch Bản 1 (Rủi Ro Cao)</button>
                                <button type="button" class="btn btn-sm btn-outline-success me-1 fw-bold" onclick="setPreset(2)">Kịch Bản 2 (An Toàn)</button>
                                <button type="button" class="btn btn-sm btn-outline-warning fw-bold" onclick="setPreset(3)">Kịch Bản 3 (Rủi Ro Vừa)</button>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small fw-bold">1. Lead Time (Số ngày đặt trước):</label>
                                <input type="number" class="form-control form-control-sm" id="aiLeadTime" value="90" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">2. Giá phòng trung bình (ADR VNĐ):</label>
                                <input type="number" class="form-control form-control-sm" id="aiAdr" value="1500000" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">3. Lịch sử số lần hủy phòng trước đây:</label>
                                <input type="number" class="form-control form-control-sm" id="aiPrevCancel" value="2" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">4. Hình thức đặt cọc (Deposit Type):</label>
                                <select class="form-select form-select-sm" id="aiDeposit">
                                    <option value="1">Không đặt cọc (No Deposit)</option>
                                    <option value="0">Có đặt cọc (Non Refundable)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">5. Yêu cầu dịch vụ đặc biệt:</label>
                                <input type="number" class="form-control form-control-sm" id="aiSpecialReq" value="0" />
                            </div>

                            <!-- Bước 2: Kích hoạt chạy AI dự báo -->
                            <button type="button" class="btn btn-danger w-100 fw-bold py-2 shadow-sm" onclick="runAiDssPrediction()">
                                <i class="bi bi-play-circle-fill me-1"></i> 🔮 CHẠY AI DỰ BÁO XGBOOST & DSS ONTOLOGY
                            </button>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm p-4 bg-white h-100">
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up-arrow me-2"></i> Kết Quả Dự Báo AI & Đề Xuất DSS</h5>

                            <div class="p-3 mb-3 text-center rounded text-white" id="aiRiskBox" style="background-color: #dc3545;">
                                <h6 class="mb-1 text-white-50">TỶ LỆ RỦI RO HỦY PHÒNG (CANCELLATION RISK)</h6>
                                <h1 class="display-4 fw-bold mb-0" id="aiRiskPercent">87.0%</h1>
                                <span class="badge bg-light text-dark fs-6 mt-1" id="aiAlertLevel">CẢNH BÁO ĐỎ - RẤT CAO</span>
                            </div>

                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-diagram-3 me-1"></i> Giải Thích Yếu Tố Ảnh Hưởng (Explainable AI - SHAP):</h6>
                            <ul class="list-group mb-3 small" id="aiShapList">
                                <li class="list-group-item list-group-item-danger d-flex justify-content-between align-items-center">
                                    <span>📈 Lịch sử từng hủy phòng (2 lần)</span>
                                    <span class="fw-bold">+40.0% Rủi ro</span>
                                </li>
                                <li class="list-group-item list-group-item-warning d-flex justify-content-between align-items-center">
                                    <span>📈 Đặt trước quá lâu (90 ngày)</span>
                                    <span class="fw-bold">+27.0% Rủi ro</span>
                                </li>
                                <li class="list-group-item list-group-item-danger d-flex justify-content-between align-items-center">
                                    <span>📈 Đặt phòng không cọc (No Deposit)</span>
                                    <span class="fw-bold">+15.0% Rủi ro</span>
                                </li>
                            </ul>

                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-lightbulb me-1"></i> Đề Xuất Hỗ Trợ Quyết Định (DSS & Hotel Operations Ontology):</h6>
                            <div class="alert alert-warning border-warning p-3 small mb-0" id="aiDssBox">
                                <p class="mb-1 fw-bold text-dark">🚨 <strong>Cảnh Báo Overbooking Buffer:</strong> Tỷ lệ hủy cao (87.0%). Đề xuất kích hoạt chính sách bán vượt +15% số phòng cho loại phòng này.</p>
                                <p class="mb-0 fw-bold text-dark">📩 <strong>Gửi Yêu Cầu Đặt Cọc:</strong> Gửi Email/SMS tự động yêu cầu khách đặt cọc giữ chỗ 30%.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-white rounded shadow-sm">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-table me-2"></i> BẢNG SO SÁNH NĂNG LỰC DỰ BÁO CÁC MÔ HÌNH HỌC MÁY (MỤC 2.B & 2.E TEMPORAL SPLIT)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Thuật Toán ML (Model)</th>
                                    <th>Accuracy</th>
                                    <th>Precision</th>
                                    <th>Recall</th>
                                    <th>F1-Score</th>
                                    <th>ROC-AUC</th>
                                    <th>Đánh Giá Năng Lực</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Logistic Regression (Baseline)</td>
                                    <td>78.4%</td>
                                    <td>76.2%</td>
                                    <td>68.5%</td>
                                    <td>72.1%</td>
                                    <td>0.812</td>
                                    <td>Mô hình cơ sở, chưa tối ưu</td>
                                </tr>
                                <tr>
                                    <td>Random Forest (RF)</td>
                                    <td>85.1%</td>
                                    <td>83.7%</td>
                                    <td>79.2%</td>
                                    <td>81.4%</td>
                                    <td>0.908</td>
                                    <td>Tập hợp cây (Ensemble) tốt</td>
                                </tr>
                                <tr>
                                    <td>Gradient Boosting (GBM)</td>
                                    <td>86.3%</td>
                                    <td>84.5%</td>
                                    <td>81.0%</td>
                                    <td>82.7%</td>
                                    <td>0.921</td>
                                    <td>Tăng cường chính xác cao</td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td>XGBoost Classifier (Recommended)</td>
                                    <td>87.6%</td>
                                    <td>85.9%</td>
                                    <td>83.1%</td>
                                    <td>84.5%</td>
                                    <td>0.938</td>
                                    <td>👑 MÔ HÌNH XUẤT SẮC NHẤT CHỌN TRIỂN KHAI</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 1. Sơ Đồ Lịch 7 Ngày -->
        <div class="tab-pane fade show active" id="content-timeline">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap text-primary me-2"></i> Sơ Đồ Trạng Thái Phòng & Lịch Đặt (7 Ngày Tính Từ Hôm Nay)</h5>
                    <span class="badge bg-primary fs-6" id="currentDateBadge"></span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr id="timelineHeader">
                                <th>Số Phòng</th>
                                <th>Loại Phòng</th>
                            </tr>
                        </thead>
                        <tbody id="timelineBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Quản Lý Đặt Phòng -->
        <div class="tab-pane fade" id="content-booking">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-list-task text-primary me-2"></i> Danh Sách Đơn Đặt Phòng (Lễ Tân Vận Hành)</h5>
