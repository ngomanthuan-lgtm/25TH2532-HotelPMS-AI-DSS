<script>
    let globalData = {};

    document.addEventListener('DOMContentLoaded', () => {
        loadAllData();
        switchUserRole();
    });

    function switchUserRole() {
        const role = document.getElementById('roleSelector').value;
        const nameLabel = document.getElementById('userNameLabel');
        const badge = document.getElementById('userBadge');
        const adminElements = document.querySelectorAll('.admin-only');

        if (role === 'admin') {
            nameLabel.innerText = 'Ngô Mẫn Thuận (MSSV: 25TH2532)';
            badge.innerText = 'ADMIN';
            badge.className = 'badge bg-danger ms-1';
            adminElements.forEach(el => el.style.display = '');
        } else {
            nameLabel.innerText = 'Lễ Tân Ca 1';
            badge.innerText = 'LỄ TÂN';
            badge.className = 'badge bg-info text-dark ms-1';
            adminElements.forEach(el => el.style.display = 'none');
        }
    }

    // CHỈ ĐIỀN THÔNG SỐ VÀO FORM KHI CHỌN KỊCH BẢN MẪU (CHƯA HIỆN KẾT QUẢ)
    function setPreset(num) {
        if (num === 1) {
            document.getElementById('aiLeadTime').value = 90;
            document.getElementById('aiAdr').value = 1500000;
            document.getElementById('aiPrevCancel').value = 2;
            document.getElementById('aiDeposit').value = 1;
            document.getElementById('aiSpecialReq').value = 0;
        } else if (num === 2) {
            document.getElementById('aiLeadTime').value = 3;
            document.getElementById('aiAdr').value = 600000;
            document.getElementById('aiPrevCancel').value = 0;
            document.getElementById('aiDeposit').value = 0;
            document.getElementById('aiSpecialReq').value = 2;
        } else {
            document.getElementById('aiLeadTime').value = 25;
            document.getElementById('aiAdr').value = 900000;
            document.getElementById('aiPrevCancel').value = 0;
            document.getElementById('aiDeposit').value = 1;
            document.getElementById('aiSpecialReq').value = 1;
        }
    }

    // CHỈ TÍNH TOÁN VÀ CẬP NHẬT TRỰC TIẾP LÊN MÀN HÌNH KẾT QUẢ KHI BẤM NÚT CHẠY AI DỰ BÁO
    function runAiDssPrediction() {
        const leadTime = parseInt(document.getElementById('aiLeadTime').value) || 0;
        const adr = parseFloat(document.getElementById('aiAdr').value) || 0;
        const prevCancel = parseInt(document.getElementById('aiPrevCancel').value) || 0;
        const depositNo = parseInt(document.getElementById('aiDeposit').value);
        const specialReq = parseInt(document.getElementById('aiSpecialReq').value) || 0;

        let risk = 0.10;
        risk += Math.min(0.45, leadTime * 0.003);
        risk += Math.min(0.35, prevCancel * 0.20);
        if (depositNo === 1) risk += 0.15;
        if (specialReq > 0) risk -= (specialReq * 0.08);

        risk = Math.max(0.05, Math.min(0.95, risk));
        const riskPct = (risk * 100).toFixed(1);

        const riskBox = document.getElementById('aiRiskBox');
        const riskPercentEl = document.getElementById('aiRiskPercent');
        const alertLevelEl = document.getElementById('aiAlertLevel');
        const shapListEl = document.getElementById('aiShapList');
        const dssBoxEl = document.getElementById('aiDssBox');

        riskPercentEl.innerText = riskPct + '%';

        let shapHtml = '';
        if (prevCancel > 0) {
            shapHtml += `<li class="list-group-item list-group-item-danger d-flex justify-content-between"><span>📈 Lịch sử hủy phòng (${prevCancel} lần)</span><span class="fw-bold">+${(prevCancel * 20).toFixed(1)}% Rủi ro</span></li>`;
        }
        if (leadTime > 14) {
            shapHtml += `<li class="list-group-item list-group-item-warning d-flex justify-content-between"><span>📈 Thời gian đặt trước xa (${leadTime} ngày)</span><span class="fw-bold">+${(leadTime * 0.3).toFixed(1)}% Rủi ro</span></li>`;
        }
        if (depositNo === 1) {
            shapHtml += `<li class="list-group-item list-group-item-danger d-flex justify-content-between"><span>📈 Đặt phòng không cọc (No Deposit)</span><span class="fw-bold">+15.0% Rủi ro</span></li>`;
        }
        if (specialReq > 0) {
            shapHtml += `<li class="list-group-item list-group-item-success d-flex justify-content-between"><span>📉 Có yêu cầu dịch vụ đặc biệt (${specialReq})</span><span class="fw-bold">-${(specialReq * 8).toFixed(1)}% Rủi ro</span></li>`;
        }
        if (!shapHtml) {
            shapHtml = `<li class="list-group-item list-group-item-success d-flex justify-content-between"><span>📉 Đơn đặt phòng có độ tin cậy cao</span><span class="fw-bold">An Toàn</span></li>`;
        }
        shapListEl.innerHTML = shapHtml;

        if (risk > 0.70) {
            riskBox.style.backgroundColor = '#dc3545';
            riskBox.className = 'p-3 mb-3 text-center rounded text-white';
            alertLevelEl.innerText = 'CẢNH BÁO ĐỎ - RẤT CAO';
            dssBoxEl.innerHTML = `<p class="mb-1 fw-bold text-dark">🚨 <strong>Cảnh Báo Overbooking Buffer:</strong> Tỷ lệ hủy cao (${riskPct}%). Đề xuất kích hoạt chính sách bán vượt +15% số phòng cho loại phòng này.</p>
                                  <p class="mb-0 fw-bold text-dark">📩 <strong>Gửi Yêu Cầu Đặt Cọc:</strong> Gửi Email/SMS tự động yêu cầu khách đặt cọc giữ chỗ 30%.</p>`;
        } else if (risk > 0.40) {
            riskBox.style.backgroundColor = '#ffc107';
            riskBox.className = 'p-3 mb-3 text-center rounded text-dark';
            alertLevelEl.innerText = 'CẢNH BÁO VÀNG - TRUNG BÌNH';
            dssBoxEl.innerHTML = `<p class="mb-0 fw-bold text-dark">⚠️ <strong>Theo Dõi Đơn:</strong> Đề xuất gửi SMS/Email nhắc nhở lịch nhận phòng trước 48h.</p>`;
        } else {
            riskBox.style.backgroundColor = '#198754';
            riskBox.className = 'p-3 mb-3 text-center rounded text-white';
            alertLevelEl.innerText = 'AN TOÀN - THẤP';
            dssBoxEl.innerHTML = `<p class="mb-0 fw-bold text-dark">✅ <strong>Đơn Đặt Phòng Uy Tín:</strong> Giữ nguyên giữ chỗ, không cần can thiệp nghiệp vụ.</p>`;
        }
    }

    async function loadAllData() {
        try {
            const res = await fetch('/api/pms/data');
            globalData = await res.json();
            renderStats(globalData.stats);
            renderTimeline(globalData);
            renderBookings(globalData);
            renderAdminRooms(globalData);
            renderCustomers(globalData.khachHangs);
            renderServices(globalData.dichVus);
        } catch (err) {
            console.error('Lỗi nạp dữ liệu:', err);
        }
    }

    function renderStats(stats) {
        if (!stats) return;
        document.getElementById('statTongPhong').innerText = stats.tongPhong;
        document.getElementById('statDangO').innerText = stats.dangO;
        document.getElementById('statOccupancy').innerText = stats.occupancy + '%';
        document.getElementById('statDoanhThu').innerText = Number(stats.tongDoanhThu).toLocaleString('vi-VN') + ' VNĐ';
    }

    function renderTimeline(data) {
        const header = document.getElementById('timelineHeader');
        const body = document.getElementById('timelineBody');
        header.innerHTML = '<th>Số Phòng</th><th>Loại Phòng</th>';

        const today = new Date();
        const dates = [];

        const ddToday = String(today.getDate()).padStart(2, '0');
        const mmToday = String(today.getMonth() + 1).padStart(2, '0');
        const yyyyToday = today.getFullYear();
        document.getElementById('currentDateBadge').innerText = `Hôm Nay: ${ddToday}/${mmToday}/${yyyyToday}`;

        for (let i = 0; i < 7; i++) {
            const d = new Date();
            d.setDate(today.getDate() + i);

            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            const dateStr = `${yyyy}-${mm}-${dd}`;
            dates.push(dateStr);

            const dayTitle = (i === 0) ? `<span class="badge bg-warning text-dark fs-6">Hôm nay</span><br>${dd}/${mm}` : `${dd}/${mm}`;
            header.innerHTML += `<th class="${i === 0 ? 'table-warning' : ''}">${dayTitle}</th>`;
        }

        body.innerHTML = '';
        data.phongs.forEach(p => {
            const lp = data.loaiPhongs.find(l => l.maLoaiPhong === p.maLoaiPhong);
            let tr = `<tr><td class="fw-bold bg-light">${p.soPhong}</td><td><span class="badge bg-secondary">${lp ? lp.tenLoaiPhong : ''}</span></td>`;

            dates.forEach((d, idx) => {
                const bk = data.datPhongs.find(b => b.maPhong === p.maPhong && b.trangThai !== 'Đã Hủy' && d >= b.ngayNhanDuKien && d <= b.ngayTraDuKien);
                if (bk) {
                    const bgClass = bk.trangThai === 'CheckIn' ? 'bg-primary text-white fw-bold' : 'bg-warning text-dark fw-bold';
                    tr += `<td class="${bgClass} small align-middle">${bk.trangThai}</td>`;
                } else {
                    tr += `<td class="bg-light text-muted small align-middle">Trống</td>`;
                }
            });

            tr += '</tr>';
            body.innerHTML += tr;
        });
    }

    function renderBookings(data) {
        const body = document.getElementById('bookingTableBody');
        body.innerHTML = '';

        data.datPhongs.forEach(b => {
            const p = data.phongs.find(x => x.maPhong === b.maPhong);
            const kh = data.khachHangs.find(x => x.maKhachHang === b.maKhachHang);

            let statusBadge = '<span class="badge bg-secondary">' + b.trangThai + '</span>';
            if (b.trangThai === 'Đã Xác Nhận') statusBadge = '<span class="badge bg-success">Đã Xác Nhận</span>';
            if (b.trangThai === 'CheckIn') statusBadge = '<span class="badge bg-primary">CheckIn</span>';
            if (b.trangThai === 'CheckOut') statusBadge = '<span class="badge bg-dark">CheckOut</span>';
            if (b.trangThai === 'Đã Hủy') statusBadge = '<span class="badge bg-danger">Đã Hủy</span>';

            let actions = '';
            if (b.trangThai === 'Đã Xác Nhận') {
                actions = `<button class="btn btn-sm btn-success me-1" onclick="checkIn(${b.maDatPhong})"><i class="bi bi-box-arrow-in-right"></i> Check-In</button>
                           <button class="btn btn-sm btn-danger" onclick="cancelBooking(${b.maDatPhong})"><i class="bi bi-x-circle"></i> Hủy</button>`;
            } else if (b.trangThai === 'CheckIn') {
                actions = `<button class="btn btn-sm btn-primary fw-bold" onclick="checkOut(${b.maDatPhong})"><i class="bi bi-receipt"></i> Check-Out & Xuất HD</button>`;
            } else {
                actions = `<span class="text-muted small">Đã hoàn thành</span>`;
            }

            body.innerHTML += `<tr>
                <td>#BK${String(b.maDatPhong).padStart(3, '0')}</td>
                <td>Phòng ${p ? p.soPhong : b.maPhong}</td>
                <td>${kh ? kh.hoTen : 'KH #' + b.maKhachHang}</td>
                <td>${b.ngayNhanDuKien}</td>
                <td>${b.ngayTraDuKien}</td>
                <td>${statusBadge}</td>
                <td>${actions}</td>
            </tr>`;
        });
    }

    function renderAdminRooms(data) {
        const body = document.getElementById('roomAdminTableBody');
        body.innerHTML = '';
        data.phongs.forEach(p => {
            const lp = data.loaiPhongs.find(l => l.maLoaiPhong === p.maLoaiPhong);
            body.innerHTML += `<tr>
                <td>#P${p.maPhong}</td>
                <td class="fw-bold">Phòng ${p.soPhong}</td>
                <td>${lp ? lp.tenLoaiPhong : p.maLoaiPhong}</td>
                <td><span class="badge ${p.trangThai === 'Đang ở' ? 'bg-primary' : 'bg-success'}">${p.trangThai}</span></td>
            </tr>`;
        });
    }

    function renderCustomers(khs) {
        const body = document.getElementById('customerTableBody');
        body.innerHTML = '';
        khs.forEach(k => {
            body.innerHTML += `<tr>
                <td>KH#${k.maKhachHang}</td>
                <td class="fw-bold">${k.hoTen}</td>
                <td>${k.soCCCD}</td>
                <td>${k.soDienThoai}</td>
                <td>${k.email}</td>
            </tr>`;
        });
    }

    function renderServices(dvs) {
        const body = document.getElementById('serviceTableBody');
        body.innerHTML = '';
        dvs.forEach(d => {
            body.innerHTML += `<tr>
                <td>DV#${d.maDichVu}</td>
                <td class="fw-bold">${d.tenDichVu}</td>
                <td>${Number(d.donGia).toLocaleString('vi-VN')} VNĐ</td>
            </tr>`;
        });
    }

    function openNewBookingModal() {
        const khSelect = document.getElementById('bookKhachHang');
        const pSelect = document.getElementById('bookPhong');
        khSelect.innerHTML = globalData.khachHangs.map(k => `<option value="${k.maKhachHang}">${k.hoTen} (${k.soCCCD})</option>`).join('');
        pSelect.innerHTML = globalData.phongs.map(p => `<option value="${p.maPhong}">Phòng ${p.soPhong}</option>`).join('');

        const today = new Date().toISOString().split('T')[0];
        document.getElementById('bookNgayNhan').value = today;
        const tomorrow = new Date(Date.now() + 86400000).toISOString().split('T')[0];
        document.getElementById('bookNgayTra').value = tomorrow;

        new bootstrap.Modal(document.getElementById('bookingModal')).show();
    }

    function openAddRoomModal() {
        const lpSelect = document.getElementById('newMaLoaiPhong');
        lpSelect.innerHTML = globalData.loaiPhongs.map(l => `<option value="${l.maLoaiPhong}">${l.tenLoaiPhong}</option>`).join('');
        new bootstrap.Modal(document.getElementById('addRoomModal')).show();
    }

    function openAddCustomerModal() {
        new bootstrap.Modal(document.getElementById('addCustomerModal')).show();
    }

    function openAddServiceModal() {
        new bootstrap.Modal(document.getElementById('addServiceModal')).show();
    }

    async function submitNewBooking() {
        const data = {
            maKhachHang: parseInt(document.getElementById('bookKhachHang').value),
            maPhong: parseInt(document.getElementById('bookPhong').value),
            ngayNhanDuKien: document.getElementById('bookNgayNhan').value,
            ngayTraDuKien: document.getElementById('bookNgayTra').value
        };

        try {
            const res = await fetch('/Booking/DatPhongMoi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
                loadAllData();
            } else {
                alert(result.message);
            }
        } catch (err) {
            alert('Lỗi kết nối!');
        }
    }

    async function submitAddRoom() {
        const data = {
            soPhong: document.getElementById('newSoPhong').value,
            maLoaiPhong: parseInt(document.getElementById('newMaLoaiPhong').value),
            trangThai: 'Trống'
        };
        try {
            const res = await fetch('/Booking/ThemPhong', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                bootstrap.Modal.getInstance(document.getElementById('addRoomModal')).hide();
                loadAllData();
            }
        } catch { alert('Lỗi!'); }
    }

    async function submitAddCustomer() {
        const data = {
            hoTen: document.getElementById('custHoTen').value,
            soCCCD: document.getElementById('custCCCD').value,
            soDienThoai: document.getElementById('custSDT').value,
            email: document.getElementById('custEmail').value
        };
        try {
            const res = await fetch('/Booking/ThemKhachHang', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                bootstrap.Modal.getInstance(document.getElementById('addCustomerModal')).hide();
                loadAllData();
            }
        } catch { alert('Lỗi!'); }
    }

    async function submitAddService() {
        const data = {
            tenDichVu: document.getElementById('servTen').value,
            donGia: parseFloat(document.getElementById('servDonGia').value)
        };
        try {
            const res = await fetch('/Booking/ThemDichVu', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                bootstrap.Modal.getInstance(document.getElementById('addServiceModal')).hide();
                loadAllData();
            }
        } catch { alert('Lỗi!'); }
    }

    async function checkIn(id) {
        try {
            const res = await fetch('/Booking/CheckIn/' + id, { method: 'POST' });
            const data = await res.json();
            if (res.ok) {
                loadAllData();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Lỗi kết nối!');
        }
    }

    async function checkOut(id) {
        if (!confirm('Xác nhận Check-out và xuất hóa đơn cho đơn này?')) return;
        try {
            const res = await fetch('/Booking/CheckOut/' + id, { method: 'POST' });
            const data = await res.json();
            if (res.ok) {
                loadAllData();
                showInvoiceModal(data.hoaDon);
            } else {
                alert(data.message || 'Lỗi Check-out');
            }
        } catch (err) {
            alert('Lỗi kết nối!');
        }
    }

    async function cancelBooking(id) {
        if (!confirm('Xác nhận hủy đơn đặt phòng này?')) return;
        try {
            const res = await fetch('/Booking/HuyDatPhong/' + id, { method: 'POST' });
            const data = await res.json();
            if (res.ok) {
                loadAllData();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Lỗi kết nối!');
        }
    }

    function showInvoiceModal(hd) {
        if (!hd) return;
        document.getElementById('invMaHD').innerText = 'HD-' + String(hd.maHoaDon).padStart(4, '0');
        document.getElementById('invKhachHang').innerText = hd.tenKhachHang;
        document.getElementById('invCCCD').innerText = hd.soCCCD;
        document.getElementById('invPhong').innerText = 'Phòng ' + hd.soPhong + ' (' + hd.tenLoaiPhong + ')';
        document.getElementById('invNgayO').innerText = hd.ngayNhan + ' ➔ ' + hd.ngayTra + ' (' + hd.soNgay + ' đêm)';
        document.getElementById('invDonGia').innerText = Number(hd.donGia).toLocaleString('vi-VN') + ' VNĐ/đêm';
        document.getElementById('invTienPhong').innerText = Number(hd.tongTienPhong).toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('invTienDichVu').innerText = Number(hd.tongTienDichVu).toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('invTongThanhToan').innerText = Number(hd.tongThanhToan).toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('invNgayLap').innerText = hd.ngayLap;

        new bootstrap.Modal(document.getElementById('invoiceModal')).show();
    }
</script>