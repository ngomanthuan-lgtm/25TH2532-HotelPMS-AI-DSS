</div>

<!-- MODALS HỆ THỐNG -->
<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2"></i> Đặt Phòng Mới (Lễ Tân)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="bookingForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Khách Hàng</label>
                        <select class="form-select" id="bookKhachHang" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Phòng</label>
                        <select class="form-select" id="bookPhong" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày Nhận Dự Kiến</label>
                        <input type="date" class="form-control" id="bookNgayNhan" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày Trả Dự Kiến</label>
                        <input type="date" class="form-control" id="bookNgayTra" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary fw-bold" onclick="submitNewBooking()">Lưu Đặt Phòng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addRoomModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-house-add me-2"></i> Thêm Phòng Mới (Quản Trị Viên)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
